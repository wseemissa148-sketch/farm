                -- Farm Mobs
                local enemies = Workspace.Enemies:GetChildren()
                local mobFound = false
                
                for _, enemy in pairs(enemies) do
                    if not _G.Config.AutoFarmLevel then StopMovement() break end
                    if enemy.Name == currentTarget.Name and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                        mobFound = true
                        while _G.Config.AutoFarmLevel and enemy and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 do
                            task.wait()
                            EquipWeapon()
                            local attackPos = enemy.HumanoidRootPart.CFrame * CFrame.new(0, _G.Config.AttackDistance, 0)
                            TweenTo(attackPos, 320)
                            Bringmobs(enemy.HumanoidRootPart.CFrame)
                            FastAttack()
                        end
                        StopMovement()
                    end
                end
                
                if not mobFound then
                    TweenTo(currentTarget.CFrame, 320)
                end
            end)
        end
    end
end)

