-- ==========================================
-- 4. المحرك الأساسي لـ Auto Farm Level
-- ==========================================

task.spawn(function()
    while true do
        task.wait(0.1)
        if _G.Config.AutoFarmLevel then
            pcall(function()
                -- تفعيل الهاكي إن وجد
                if _G.Config.AutoBuso and not player.Character:FindFirstChild("HasBuso") then
                    ReplicatedStorage.Remotes.CommF_:InvokeServer("HasBuso")
                end
                
                -- البحث عن البوتات القريبة القابلة للهجوم
                local enemies = workspace.Enemies:GetChildren()
                local hasTarget = false
                
                for _, enemy in pairs(enemies) do
                    if _G.Config.AutoFarmLevel and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                        hasTarget = true
                        while _G.Config.AutoFarmLevel and enemy and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 do
                            task.wait()
                            EquipWeapon()
                            TweenTo(enemy.HumanoidRootPart.CFrame * CFrame.new(0, 10, 0), 320)
                            FastClick()
                        end
                        StopMovement()
                    end
                end
                
                if not hasTarget then
                    StopMovement()
                end
            end)
        end
    end
end)

