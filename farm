local function StopMovement()
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
        LocalPlayer.Character.HumanoidRootPart.RotVelocity = Vector3.new(0, 0, 0)
    end
end

local function TweenTo(cframe, speed)
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        local dist = (hrp.Position - cframe.Position).Magnitude
        if dist < 8 then
            hrp.CFrame = cframe
            return
        end
        StopMovement()
        local moveSpeed = speed or _G.Config.TweenSpeed
        local info = TweenInfo.new(dist / moveSpeed, Enum.EasingStyle.Linear)
        currentTween = TweenService:Create(hrp, info, {CFrame = cframe})
        currentTween:Play()
        return currentTween
    end
end

local function EquipWeapon()
    local backpack = LocalPlayer.Backpack
    local char = LocalPlayer.Character
    if not char then return end
    for _, item in pairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            if _G.Config.SelectWeapon == "Melee" and item.ToolTip == "Melee" then
                char.Humanoid:EquipTool(item)
            elseif _G.Config.SelectWeapon == "Blox Fruit" and item.ToolTip == "Blox Fruit" then
                char.Humanoid:EquipTool(item)
            elseif _G.Config.SelectWeapon == "Sword" and item.ToolTip == "Sword" then
                char.Humanoid:EquipTool(item)
            elseif _G.Config.SelectWeapon == "Gun" and item.ToolTip == "Gun" then
                char.Humanoid:EquipTool(item)
            end
        end
    end
end

local function Bringmobs(targetCFrame)
    if not _G.Config.BringMobs then return end
    for _, enemy in pairs(Workspace.Enemies:GetChildren()) do
        if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
            if (enemy.HumanoidRootPart.Position - targetCFrame.Position).Magnitude <= 350 then
                enemy.HumanoidRootPart.CFrame = targetCFrame * CFrame.new(0, 0, -3)
                enemy.HumanoidRootPart.Size = Vector3.new(40, 40, 40)
                enemy.Humanoid.JumpPower = 0
                enemy.Humanoid.WalkSpeed = 0
                enemy.HumanoidRootPart.CanCollide = false
            end
        end
    end
end

local function FastAttack()
    if _G.Config.FastAttack then
        VirtualUser:CaptureController()
        VirtualUser:ClickButton1(Vector2.new(500, 500))
    end
end

local function GetCurrentTargetData()
    local level = GetPlayerLevel()
    for _, data in ipairs(LevelData) do
        if level >= data.Min and level <= data.Max then
            return data
        end
    end
    return LevelData[#LevelData]
end

