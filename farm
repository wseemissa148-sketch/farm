-- 5. المحرك الذكي للتنقل المباشر وتتبع البوتات
-- ==========================================

task.spawn(function()
    while true do
        task.wait(0.1)
        if _G.Config.AutoFarmLevel then
            pcall(function()
                local qData = GetQuestData()
                
                -- أخذ المهمة إذا لم تكن مأخوذة
                if not player.PlayerGui.Main:FindFirstChild("Quest") or not player.PlayerGui.Main.Quest.Visible then
                    if qData.QuestName ~= "Auto" then
                        TweenTo(qData.QuestNPC, 320)
                        if (player.Character.HumanoidRootPart.Position - qData.QuestNPC.Position).Magnitude < 15 then
                            ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", qData.QuestName, qData.QuestLevel)
                        end
                    end
                end
                
                -- البحث عن البوت المطلوب ومهاجمته من الأعلى
                local enemies = workspace.Enemies:GetChildren()
                local foundTarget = false
                
                for _, enemy in pairs(enemies) do
                    if not _G.Config.AutoFarmLevel then StopMovement() break end
                    if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                        if qData.EnemyName == "" or enemy.Name:find(qData.EnemyName) or player.Data.Level.Value >= 2550 then
                            foundTarget = true
                            while _G.Config.AutoFarmLevel and enemy and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 do
                                task.wait()
                                EquipWeapon()
                                TweenTo(enemy.HumanoidRootPart.CFrame * CFrame.new(0, 10, 0), 320)
                                FastClick()
                            end
                            StopMovement()
                        end
                    end
                end
                
                -- إذا لم يجد البوت قريب يذهب إلى منطقة رسبنتهم المخصصة
                if not foundTarget and _G.Config.AutoFarmLevel then
                    TweenTo(qData.EnemyCFrame, 320)
                end
            end)
        end
    end
end)
