local function GetQuestData()
    local level = player.Data.Level.Value
    
    -- Sea 1 / Sea 2 / Sea 3 (خوارزمية الفحص الذاتي)
    if level >= 2550 then
        -- Max Level Quest/Farm (Chocolate Bar Battlers / Candy Island)
        return {
            QuestName = "ChocolateQuest1",
            QuestLevel = 1,
            QuestNPC = CFrame.new(288.7, 24.7, -12528.2),
            EnemyName = "Chocolate Bar Battler",
            EnemyCFrame = CFrame.new(220, 25, -12100)
        }
    elseif level >= 1 and level < 15 then
        return {
            QuestName = "BanditQuest1",
            QuestLevel = 1,
            QuestNPC = CFrame.new(1059.3, 15.4, 1550.4),
            EnemyName = "Bandit",
            EnemyCFrame = CFrame.new(1185, 16, 1625)
        }
    elseif level >= 15 and level < 30 then
        return {
            QuestName = "JungleQuest",
            QuestLevel = 1,
            QuestNPC = CFrame.new(-1598, 35, 153),
            EnemyName = "Monkey",
            EnemyCFrame = CFrame.new(-1620, 35, 140)
        }
    else
        -- القالب العام التلقائي لأقرب بوتات تناسب مستواك
        return {
            QuestName = "Auto",
            QuestLevel = 1,
            QuestNPC = player.Character.HumanoidRootPart.CFrame,
            EnemyName = "",
            EnemyCFrame = player.Character.HumanoidRootPart.CFrame
        }
    end
end

