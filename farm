    Button.Text = "  " .. name
    Button.TextColor3 = _G.Config[configVar] and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 160)
    Button.Font = Enum.Font.GothamMedium
    Button.TextSize = 10
    Button.TextXAlignment = Enum.TextXAlignment.Left
    Button.Parent = parentPage

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = Button

    local Indicator = Instance.new("Frame")
    Indicator.Size = UDim2.new(0, 28, 0, 14)
    Indicator.Position = UDim2.new(1, -34, 0.5, -7)
    Indicator.BackgroundColor3 = _G.Config[configVar] and Color3.fromRGB(0, 230, 180) or Color3.fromRGB(45, 52, 68)
    Indicator.Parent = Button

    local IndCorner = Instance.new("UICorner")
    IndCorner.CornerRadius = UDim.new(0, 10)
    IndCorner.Parent = Indicator

    Button.MouseButton1Click:Connect(function()
        _G.Config[configVar] = not _G.Config[configVar]
        Indicator.BackgroundColor3 = _G.Config[configVar] and Color3.fromRGB(0, 230, 180) or Color3.fromRGB(45, 52, 68)
        Button.TextColor3 = _G.Config[configVar] and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 160)
        if not _G.Config[configVar] then StopMovement() end
    end)
    return Button
end

-- تصميم القائمة المنسدلة للجزر (Dropdown Menu)
local function AddDropdown(parentPage, title, optionsList, configVar)
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(0.96, 0, 0, 40)
    Container.BackgroundColor3 = Color3.fromRGB(22, 28, 40)
    Container.ClipsDescendants = true
    Container.Parent = parentPage

    local CCorner = Instance.new("UICorner")
    CCorner.CornerRadius = UDim.new(0, 6)
    CCorner.Parent = Container

    local HeaderBtn = Instance.new("TextButton")
    HeaderBtn.Size = UDim2.new(1, 0, 0, 40)
    HeaderBtn.BackgroundTransparency = 1
    HeaderBtn.Text = "  " .. title .. " : " .. (_G.Config[configVar] ~= "" and _G.Config[configVar] or "اختر جزيرة")
    HeaderBtn.TextColor3 = Color3.fromRGB(0, 230, 180)
    HeaderBtn.Font = Enum.Font.GothamBold
    HeaderBtn.TextSize = 10
    HeaderBtn.TextXAlignment = Enum.TextXAlignment.Left
    HeaderBtn.Parent = Container

    local DropList = Instance.new("Frame")
    DropList.Size = UDim2.new(1, 0, 0, #optionsList * 28)
    DropList.Position = UDim2.new(0, 0, 0, 40)
    DropList.BackgroundTransparency = 1
    DropList.Parent = Container

    local DropLayout = Instance.new("UIListLayout")
    DropLayout.Parent = DropList

    local isExpanded = false

    HeaderBtn.MouseButton1Click:Connect(function()
        isExpanded = not isExpanded
        Container.Size = isExpanded and UDim2.new(0.96, 0, 0, 40 + (#optionsList * 28)) or UDim2.new(0.96, 0, 0, 40)
    end)

    for _, optName in ipairs(optionsList) do
        local ItemBtn = Instance.new("TextButton")
        ItemBtn.Size = UDim2.new(1, 0, 0, 28)
        ItemBtn.BackgroundColor3 = Color3.fromRGB(28, 35, 50)
        ItemBtn.Text = "    • " .. optName
        ItemBtn.TextColor3 = Color3.fromRGB(200, 210, 225)
        ItemBtn.Font = Enum.Font.GothamMedium
        ItemBtn.TextSize = 9
        ItemBtn.TextXAlignment = Enum.TextXAlignment.Left
        ItemBtn.Parent = DropList

        ItemBtn.MouseButton1Click:Connect(function()
            _G.Config[configVar] = optName
            HeaderBtn.Text = "  " .. title .. " : " .. optName
            isExpanded = false
            Container.Size = UDim2.new(0.96, 0, 0, 40)
        end)
    end
end

